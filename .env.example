# 和风天气 API 配置
WEATHER_API_KEY=your_weather_api_key_here
WEATHER_API_URL=https://devapi.qweather.com/v7/weather/now
WEATHER_HOURLY_URL=https://devapi.qweather.com/v7/weather/24h
WEATHER_DAILY_URL=https://devapi.qweather.com/v7/weather/7d

# Deepseek API 配置
DEEPSEEK_API_KEY=your_deepseek_api_key_here
DEEPSEEK_API_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-v4-flash

# CloudBase 环境配置
CLOUDBASE_ENV_ID=your_cloudbase_env_id

# API 超时设置（秒）
API_TIMEOUT=3
API_RETRY_COUNT=3