        "path": "/api/weather",
        "method": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "enableCORS": true,
        "isIntegrated": true
      }
    },
    {
      "name": "ai_summary",
      "timeout": 60,
      "memorySize": 512,
      "runtime": "Nodejs20.19",
