{
  "envId": "personal-d8ge1nis6551fced9",
  "functionRoot": "cloudfunctions",
  "app": {
    "root": "./frontend",
    "framework": "vite",
    "installCommand": "npm install",
    "buildCommand": "npm run build",
    "outputDir": "dist",
    "deployPath": "/"
  },
  "functions": [
    {
      "name": "travel_plan",
      "timeout": 30,
      "memorySize": 256,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "Travel Planner - Plan Management Cloud Function",
      "envVariables": {},
      "webFunctionConfig": {
        "path": "/api",
        "method": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "enableCORS": false,
        "isIntegrated": true
      }
    },
    {
      "name": "weather",
      "timeout": 30,
      "memorySize": 256,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "Travel Planner - Weather Service Cloud Function",
      "envVariables": {},
      "webFunctionConfig": {
        "path": "/api/weather",
        "method": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "enableCORS": false,
        "isIntegrated": true
      }
    },
    {
      "name": "ai_summary",
      "timeout": 60,
      "memorySize": 512,
      "runtime": "Nodejs20.19",
      "handler": "index.main",
      "description": "Travel Planner - AI Summary Cloud Function",
      "envVariables": {},
      "webFunctionConfig": {
        "path": "/api/plans/summary",
        "method": ["GET", "POST", "PUT", "DELETE", "OPTIONS"],
        "enableCORS": false,
        "isIntegrated": true
      }
    }
  ]
}